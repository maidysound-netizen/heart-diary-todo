# Auth.js — `npx auth secret` 로 생성
AUTH_SECRET=
# Google Cloud Console > API 및 서비스 > 사용자 인증 정보 > OAuth 클라이언트 ID(웹)
# 승인된 리디렉션 URI: https://<배포도메인>/api/auth/callback/google , http://localhost:3000/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# 초대한 사람만 로그인 (쉼표로 구분한 구글 이메일). 비워 두면 누구나 로그인 가능
ALLOWED_EMAILS=
# Neon PostgreSQL 연결 문자열 (비워두면 로컬에서는 .pglite 폴더의 내장 Postgres 사용)
DATABASE_URL=
# Vercel Blob (사진 업로드, 선택)
BLOB_READ_WRITE_TOKEN=
# 로컬 개발에서만: Google 없이 테스트 계정 로그인 허용 (배포 환경에서는 절대 켜지 마세요)
AUTH_DEV_LOGIN=1
